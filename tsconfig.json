{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["*.ts", "library/*", "lib/*", "scripts/*", "targets/*", "tests/*"]
}
